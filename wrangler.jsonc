/**
 * SnowSignals x402 gateway — Wrangler configuration.
 *
 * Non-secret resource coordinates live here (the KV namespace id, the merchant `PAY_TO`, the origin
 * and facilitator URLs) — none of them grant access on their own. The credentials that do are set as
 * `wrangler secret` (HOUSE_API_KEY, CDP_API_KEY_ID, CDP_API_KEY_SECRET) and never committed, and the
 * Cloudflare account id is passed by env at deploy. Nothing secret lives in this file.
 * See https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "snowsignals-x402",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	// The x402 / CDP facilitator auth SDK (@coinbase/cdp-sdk) imports Node builtins (crypto); the
	// gateway needs the Node compatibility layer to bundle and run on Workers.
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
	},
	"vars": {
		// The liveserv origin this gateway resells. Origin paths hang off `${ORIGIN_URL}/v1/api/...`.
		"ORIGIN_URL": "https://snowsignals.io",
		// CDP facilitator that verifies + settles x402 payments on Base.
		"FACILITATOR_URL": "https://api.cdp.coinbase.com/platform/v2/x402",
		// PAY_TO — merchant address that receives USDC. Receive-only (key held in hotsign; evm HD
		// index 4). FORKERS: replace with your OWN receive address.
		"PAY_TO": "0x9273429D71565154fA0FDf4Bf0f404Eb02C91518",
	},
	// Per-row phase cache (keyed `${kind}:${currency}:${tf}:${bucket}`). FORKERS: create your own KV
	// namespace (`wrangler kv namespace create PHASE_CACHE`) and put its id here.
	"kv_namespaces": [
		{
			"binding": "PHASE_CACHE",
			"id": "2ce6fc0b5f1d4b39a795a9f4004911d0",
		},
	],
	// Per-currency single-flight coordinator (one instance per currency; coalesces concurrent
	// leftover fetches). SQLite-backed, coordination-only.
	"durable_objects": {
		"bindings": [
			{
				"name": "CURRENCY_SINGLEFLIGHT",
				"class_name": "CurrencySingleFlight",
			},
		],
	},
	// Free-tier Durable Objects require the SQLite storage backend — new_sqlite_classes, NOT
	// new_classes.
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["CurrencySingleFlight"],
		},
	],
	"upload_source_maps": true,
	// Single top-level config — deploy with a plain `wrangler deploy` (no named env). A named
	// `production` env that redeclared only `vars` would silently drop the KV + DO bindings, so the
	// top-level config is the one source of truth.
}
